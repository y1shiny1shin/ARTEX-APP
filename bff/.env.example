# 复制为 bff/.env，不要提交
RYAGENT_ADDR=:8788
RYAGENT_DATA=./data
RYAGENT_OWNER_PASSWORD=change-me
ARTEX_BASE_URL=http://127.0.0.1:8787
# 二选一：服务 token 或账号密码
ARTEX_TOKEN=
ARTEX_USERNAME=ARTEX
ARTEX_PASSWORD=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# GitHub 关注动态情报：监控 GITHUB_OWNER 关注的人的 Star 与公开动态。
# GITHUB_TOKEN 强烈建议配置：无 token 时每轮只扫描 10 位关注且限流 60 次/小时。
GITHUB_OWNER=y1shiny1shin
GITHUB_TOKEN=
GITHUB_PROXY=
GITHUB_REFRESH_MINUTES=4320
# 只保留高信号事件：star/watch + release；需要其它类型可加 push,fork,pr,issue,comment
GITHUB_EVENT_TYPES=watch,release
# 忽略不相关账号的活动，逗号分隔
GITHUB_IGNORE_USERS=
# 招聘雷达：成都/远程安全岗位匹配
JOB_REFRESH_HOURS=72
JOB_CITY=成都
JOB_KEYWORDS=
JOB_MIN_SCORE=45
JOB_MAX_AGE_DAYS=30
JOB_SOURCES=iguopin,liepin,jobui,ncss,kanxue,v2ex,remoteok
JOB_PROXY=
# 安全情报：RSS/JSON 公开源，条件请求 + 限速；不需要关键词过滤
INTEL_REFRESH_MINUTES=4320
INTEL_PROXY=
# 留空=全部；可用 xz,anquanke,seebug,4hou,cnsec,xlab,freebuf,thn,bleepingcomputer,krebs,securityweek
INTEL_SOURCES=
